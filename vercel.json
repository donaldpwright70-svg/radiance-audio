{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/admin\\.php", "dest": "/api/admin.php" },
    { "src": "/stream\\.php", "dest": "/api/stream.php" },
    { "src": "/index\\.php", "dest": "/api/index.php" },
    { "src": "/", "dest": "/api/index.php" }
  ]
}
